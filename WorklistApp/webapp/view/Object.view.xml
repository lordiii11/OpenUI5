<mvc:View xmlns:core="sap.ui.core"
	controllerName="zjblessons.WorklistApp.controller.Object"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.ui.layout.form">

	<Page>
		<customHeader>
			<Bar>
				<contentLeft>
					<Title text="{= ${objectView>/bEditMode} ? 'EditMode': ${DocumentNumber}}"/>
				</contentLeft>
				<contentRight>
					<Button 
						type="Emphasized" 
						text="{i18n>ButtonEdit}" 
						icon="{i18n>iButtonEdit}" 
						visible="{= !${objectView>/bEditMode}}" 
						press="onEditButtonPress"/>
					<Button 
						type="Emphasized" 
						text="{i18n>ButtonSave}" 
						icon="{i18n>iButtonSave}" 
						visible="{= ${objectView>/bEditMode}}" 
						press="onSaveButtonPress"/>
					<Button 
						type="Transparent" 
						text="{i18n>ButtonCancel}" 
						icon="{i18n>iButtonCancel}" 
						visible="{= ${objectView>/bEditMode}}" 
						press="onCancelButtonPress"/>
					<Button 
						type="Reject" 
						text="{i18n>ButtonDelete}" 
						icon="{i18n>iButtonDelete}" 
						visible="{= !${objectView>/bEditMode} &amp;&amp; ${objectView>/bDeleteVisible}}" 
						press="onDeleteButtonPress"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<IconTabBar 
				id="idIconTabBar"
				selectedKey="= ${objectView>/sSelectedTab}" 
				headerMode="Inline">
				<items>
					<IconTabFilter key="list" text="{i18n>IconTabFilterList}" icon="{i18n>iIconTabFilterList}">
						<VBox>
							<List>
								<items>
									<CustomListItem>
										<content>
											<VBox class="sapUiContentPadding">
											<CustomListItem>
												<Label labelFor="idDocumentNumberInput" text="{i18n>tableNameColumnDocumentNumber}"/>
												<Input id="idDocumentNumberInput" editable="{= ${objectView>/bEditMode}}" value="{DocumentNumber}"/>
											</CustomListItem>
											<CustomListItem>
												<Label labelFor="idRegionTextSelect" text="{i18n>tableNameColumnRegionText}"/>
												<Select 
													id="idRegionTextSelect"
													selectedKey="{RegionID}"
													items= "{path: '/zjblessons_base_Headers'}"
													editable="{= ${objectView>/bEditMode}}">
													<items>
														<core:Item key="{RegionID}" text="{RegionText}"/>
													</items>
												</Select>
											</CustomListItem>
											<CustomListItem>
												<Label labelFor="idComboBox" text="{i18n>tableNameColumnPlantText}"/>
												<ComboBox 
												id="idComboBox"
												selectedKey="{PlantID}"
												editable="{= ${objectView>/bEditMode}}"/>
											</CustomListItem>
											<CustomListItem>
												<Label labelFor="idDescriptionInput" text="{i18n>tableNameColumnDescription}"/>
												<Input id="idDescriptionInput" editable="{= ${objectView>/bEditMode}}" value="{Description}"/>
											</CustomListItem>
											</VBox>
										</content>
									</CustomListItem>
								</items>
							</List>
						</VBox>
					</IconTabFilter>
					<IconTabFilter key="form" text="{i18n>IconTabFilterForm}" icon="{i18n>iIconTabFilterForm}">
						<VBox class="sapUiSmallMargin">
							<f:Form
								id="FormChange354wideDual"
								editable="true"
							>
								<f:title>
									<core:Title text="Address" />
								</f:title>
								<f:layout>
									<f:ResponsiveGridLayout
										labelSpanXL="4"
										labelSpanL="3"
										labelSpanM="4"
										labelSpanS="12"
										adjustLabelSpan="false"
										emptySpanXL="0"
										emptySpanL="4"
										emptySpanM="0"
										emptySpanS="0"
										columnsXL="2"
										columnsL="1"
										columnsM="1"
										singleContainerFullSize="false"
									/>
								</f:layout>
								<f:formContainers>
									<f:FormContainer title="Main">
										<f:formElements>
											<f:FormElement label="{i18n>tableNameColumnDocumentNumber}">
												<Text text="{DocumentNumber}"/>
											</f:FormElement>
											<f:FormElement label="{i18n>tableNameColumnDocumentDate}">
												<Text text="{DocumentDate}"/>
											</f:FormElement>
											<f:FormElement label="{i18n>tableNameColumnPlantText}">
												<Text text="{PlantText}"/>
											</f:FormElement>
											<f:FormElement label="{i18n>tableNameColumnRegionText}">
												<Text text="{RegionText}"/>
											</f:FormElement>
											<f:FormElement label="{i18n>tableNameColumnDescription}">
												<Text text="{Description}"/>
											</f:FormElement>
										</f:formElements>
									</f:FormContainer>
									<f:FormContainer title="Details">
										<f:formElements>
											<f:FormElement label="{i18n>tableNameColumnCreated}">
												<Text text="{
													path: 'Created',
													type: 'sap.ui.model.type.Date',
													formatOptions: {
														style: 'short'
													}
												}"/>
											</f:FormElement>
											<f:FormElement label="{i18n>tableNameColumnCreatedByFullName}">
												<Text text="{CreatedByFullName}"/>
											</f:FormElement>
											<f:FormElement label="{i18n>tableNameColumnModified}">
												<Text text="{
													path: 'Modified',
													formatter: '.formatter.modifiedFormatter'
												}"/>
											</f:FormElement>
											<f:FormElement label="{i18n>tableNameColumnModifiedByFullName}">
												<Text text="{ModifiedByFullName}"/>
											</f:FormElement>
										</f:formElements>
									</f:FormContainer>
								</f:formContainers>
							</f:Form>
						</VBox>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
	</Page>

</mvc:View>